# ---------------------------------------------------------------------------
# Local development configuration (safe defaults for docker compose + Azurite)
# Copy to .env and adjust. NEVER commit real credentials — .env is gitignored.
# The values below are the well-known Azurite development account credentials,
# published by Microsoft for local emulation; they grant access to nothing
# outside your machine.
# ---------------------------------------------------------------------------

OEOP_ENVIRONMENT=local
OEOP_LOG_LEVEL=INFO

# PostgreSQL (docker compose service `postgres`)
OEOP_DATABASE_URL=postgresql+asyncpg://oeop:oeop_local_dev@localhost:5432/oeop

# Azurite storage emulator (docker compose service `azurite`)
OEOP_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;

# In Azure these replace the connection string (managed identity):
# OEOP_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
# OEOP_QUEUE_ACCOUNT_URL=https://<account>.queue.core.windows.net

# Queue / blob names
OEOP_ARTIFACTS_CONTAINER=artifacts
OEOP_ANALYSIS_QUEUE_NAME=analysis-jobs
OEOP_POISON_QUEUE_NAME=analysis-jobs-poison

# Demo & abuse controls
OEOP_DEMO_MODE=false
OEOP_SUBMISSIONS_ENABLED=true
OEOP_RATE_LIMIT_SUBMISSIONS_PER_HOUR=10

# Visitor-drawn areas of interest. The cap is set from measured cost: outputs
# run ~0.06 MB per scene per km2, so the 200 MB per-analysis storage cap binds
# near 417 km2 at 8 scenes. 250 km2 keeps margin and matches the curated
# regions' ceiling, so users see one number rather than two.
OEOP_ALLOW_CUSTOM_AREAS=true
OEOP_MAX_CUSTOM_AOI_AREA_KM2=250

# Processing constraints (conservative defaults; see docs/cost-and-scaling.md)
OEOP_MAX_AOI_AREA_KM2=600
# ~10 years. Long spans cost no more to process (scene_limit bounds the
# work); use selection_strategy=seasonal for multi-year comparisons.
OEOP_MAX_DATE_SPAN_DAYS=3660
OEOP_MAX_SCENE_LIMIT=12
OEOP_MAX_JOB_RUNTIME_SECONDS=1500
OEOP_PER_ANALYSIS_STORAGE_LIMIT_MB=200

# CORS (the web app proxies API calls server-side, so this is rarely needed)
OEOP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Web app -> API base URL (used by the Next.js server-side proxy)
API_BASE_URL=http://localhost:8000

# Telemetry (optional; leave empty locally)
# APPLICATIONINSIGHTS_CONNECTION_STRING=
